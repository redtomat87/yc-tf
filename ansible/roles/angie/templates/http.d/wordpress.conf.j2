{% import 'macros.j2' as m %}
{% set vhost = angie_vhosts[item.vhost] | combine({'name': item.vhost}) %}
#=====================================================================
# {{ item.dest }}   {{ ansible_managed }}
# WordPress в pod'е wordpress (роль wordpress) за proxy_cache.
#=====================================================================

proxy_cache_path /var/cache/angie/wordpress levels=1:2 keys_zone=wordpress_cache:10m
                 inactive=24h max_size=1g use_temp_path=off;

# Залогиненным пользователям и комментаторам кэш не отдаём: страницы у них персональные.
map $http_cookie $wordpress_skip_cache {
    default 0;
    ~*(wordpress_logged_in|wp-postpass|comment_author|woocommerce_items_in_cart) 1;
}

upstream wordpress {
    server 127.0.0.1:{{ app_ports.wordpress }};
    keepalive 16;
    zone wordpress 1m;
}

server {
{{ m.tls_server(vhost) }}

    location / {
        include /etc/angie/snippets/proxy.conf;
        proxy_pass http://wordpress;

        proxy_cache            wordpress_cache;
        proxy_cache_key        $scheme$host$request_uri;
        proxy_cache_valid      200 301 10m;
        proxy_cache_lock       on;
        proxy_cache_use_stale  error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_cache_bypass     $wordpress_skip_cache $arg_preview;
        proxy_no_cache         $wordpress_skip_cache $arg_preview;
        proxy_cache_methods    GET HEAD;

        include /etc/angie/snippets/headers.conf;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    # Админка и вход — без кэша.
    location ~ ^/(wp-admin|wp-login\.php) {
        include /etc/angie/snippets/proxy.conf;
        proxy_pass http://wordpress;
    }

    # Частая цель перебора паролей и DDoS; блог его не использует.
    location = /xmlrpc.php {
        return 403;
    }

    location ~ /\.(?!well-known) {
        return 404;
    }
}
