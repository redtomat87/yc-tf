{#- Общая часть HTTPS-сервера: listen, HTTP/2 и HTTP/3, ACME, заголовки, логи. -#}
{% macro tls_server(vhost) -%}
    listen 443 ssl;
    listen 443 quic;
    http2 on;
    http3 on;
    quic_gso on;
    quic_retry on;

    server_name {{ vhost.server_name }};
    status_zone {{ vhost.name }};

    access_log /var/log/angie/{{ vhost.name }}.access.log extended;
    error_log  /var/log/angie/{{ vhost.name }}.error.log;

    acme {{ vhost.name }}_rsa;
    acme {{ vhost.name }}_ecdsa;
    ssl_certificate     $acme_cert_{{ vhost.name }}_rsa;
    ssl_certificate_key $acme_cert_key_{{ vhost.name }}_rsa;
    ssl_certificate     $acme_cert_{{ vhost.name }}_ecdsa;
    ssl_certificate_key $acme_cert_key_{{ vhost.name }}_ecdsa;

    include /etc/angie/snippets/headers.conf;
{%- endmacro %}

{#- Basic auth по /etc/angie/htpasswd -#}
{% macro basic_auth() -%}
        auth_basic           "Restricted";
        auth_basic_user_file /etc/angie/htpasswd;
{%- endmacro %}
