# {{ ansible_managed }}
# Grafana в сети хоста: Prometheus на этой же ВМ слушает только 127.0.0.1. К Keycloak
# (token, userinfo) Grafana ходит через Angie по записи в /etc/hosts хоста (задача роли):
# с hostNetwork hostAliases не применяются ни в Podman, ни в Kubernetes.
apiVersion: v1
kind: Secret
metadata:
  name: grafana-secrets
type: Opaque
data:
  admin-password: {{ monitoring_grafana_admin_password | b64encode }}
  oauth-client-secret: {{ monitoring_oauth_client_secret | b64encode }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-provisioning
data:
  datasources.yml: {{ {
      'apiVersion': 1,
      'datasources': [{
        'name': 'Prometheus',
        'uid': 'prometheus',
        'type': 'prometheus',
        'access': 'proxy',
        'url': 'http://' ~ peer_addr[groups['prometheus'][0]] ~ ':' ~ app_ports.prometheus ~ '/prometheus',
        'isDefault': true,
      }],
    } | to_nice_yaml | to_json }}
  dashboards.yml: {{ {
      'apiVersion': 1,
      'providers': [{
        'name': 'dashboards',
        'type': 'file',
        'allowUiUpdates': false,
        'options': {'path': '/etc/grafana/dashboards', 'foldersFromFilesStructure': true},
      }],
    } | to_nice_yaml | to_json }}
{% for dashboard in monitoring_dashboards %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-dashboard-{{ dashboard }}
data:
  {{ dashboard }}.json: {{ lookup('ansible.builtin.file', 'dashboards/' ~ dashboard ~ '.json') | to_json }}
{% endfor %}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: grafana-data
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 1Gi
---
apiVersion: v1
kind: Pod
metadata:
  name: grafana
  labels:
    app: monitoring
    component: grafana
spec:
  hostNetwork: true
  containers:
    - name: grafana
      image: {{ monitoring_grafana_image }}
      env:
        # Адрес у Grafana один: если Angie на другой ВМ — все интерфейсы
        # (снаружи порт закрыт security group).
        - name: GF_SERVER_HTTP_ADDR
          value: "{{ '0.0.0.0' if remote_consumers.web else '127.0.0.1' }}"
        - name: GF_SERVER_HTTP_PORT
          value: "{{ app_ports.grafana }}"
        - name: GF_SERVER_ROOT_URL
          value: {{ monitoring_grafana_url }}
        - name: GF_LOG_LEVEL
          value: {{ monitoring_grafana_log_level }}
        - name: GF_PATHS_PROVISIONING
          value: /etc/grafana/provisioning
        - name: GF_SECURITY_ADMIN_USER
          value: admin
        - name: GF_SECURITY_ADMIN_PASSWORD
          valueFrom: { secretKeyRef: { name: grafana-secrets, key: admin-password } }
        - name: GF_ANALYTICS_REPORTING_ENABLED
          value: "false"
        # Вход только через Keycloak.
        - name: GF_AUTH_DISABLE_LOGIN_FORM
          value: "true"
        - name: GF_AUTH_GENERIC_OAUTH_ENABLED
          value: "true"
        - name: GF_AUTH_GENERIC_OAUTH_NAME
          value: Keycloak
        - name: GF_AUTH_GENERIC_OAUTH_CLIENT_ID
          value: grafana
        - name: GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET
          valueFrom: { secretKeyRef: { name: grafana-secrets, key: oauth-client-secret } }
        - name: GF_AUTH_GENERIC_OAUTH_SCOPES
          value: openid email profile
        - name: GF_AUTH_GENERIC_OAUTH_USE_PKCE
          value: "true"
        - name: GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP
          value: "true"
        - name: GF_AUTH_GENERIC_OAUTH_AUTH_URL
          value: https://{{ monitoring_keycloak_host }}/realms/{{ monitoring_keycloak_realm }}/protocol/openid-connect/auth
        - name: GF_AUTH_GENERIC_OAUTH_TOKEN_URL
          value: https://{{ monitoring_keycloak_host }}/realms/{{ monitoring_keycloak_realm }}/protocol/openid-connect/token
        - name: GF_AUTH_GENERIC_OAUTH_API_URL
          value: https://{{ monitoring_keycloak_host }}/realms/{{ monitoring_keycloak_realm }}/protocol/openid-connect/userinfo
        - name: GF_AUTH_SIGNOUT_REDIRECT_URL
          value: https://{{ monitoring_keycloak_host }}/realms/{{ monitoring_keycloak_realm }}/protocol/openid-connect/logout?client_id=grafana&post_logout_redirect_uri={{ monitoring_grafana_url | urlencode }}%2Flogin
        # Роль grafana-admin из realm (claim roles) — Admin, остальные — Viewer.
        - name: GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH
          value: "contains(roles[*], 'grafana-admin') && 'Admin' || 'Viewer'"
      ports:
        - containerPort: {{ app_ports.grafana }}
      # Первый старт с миграциями БД на слабой ВМ занимает минуты: до готовности
      # liveness не проверяется, иначе контейнер убивают посреди миграции.
      startupProbe:
        httpGet:
          path: /api/health
          port: {{ app_ports.grafana }}
        periodSeconds: 10
        failureThreshold: 60
      livenessProbe:
        httpGet:
          path: /api/health
          port: {{ app_ports.grafana }}
        periodSeconds: 15
        failureThreshold: 4
      resources:
        limits:
          memory: {{ monitoring_grafana_memory_limit }}
      volumeMounts:
        - name: data
          mountPath: /var/lib/grafana
        - name: provisioning
          mountPath: /etc/grafana/provisioning/datasources/datasources.yml
          subPath: datasources.yml
          readOnly: true
        - name: provisioning
          mountPath: /etc/grafana/provisioning/dashboards/dashboards.yml
          subPath: dashboards.yml
          readOnly: true
{% for dashboard in monitoring_dashboards %}
        - name: dashboard-{{ dashboard }}
          mountPath: /etc/grafana/dashboards/{{ dashboard }}
          readOnly: true
{% endfor %}
  volumes:
    - name: data
      persistentVolumeClaim:
        claimName: grafana-data
    - name: provisioning
      configMap:
        name: grafana-provisioning
{% for dashboard in monitoring_dashboards %}
    - name: dashboard-{{ dashboard }}
      configMap:
        name: grafana-dashboard-{{ dashboard }}
{% endfor %}
