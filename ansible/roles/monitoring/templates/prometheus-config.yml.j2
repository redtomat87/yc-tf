global:
  scrape_interval: 15s
  scrape_timeout: 10s
  evaluation_interval: 15s

# Pod monitoring в сети хоста: все экспортеры доступны на 127.0.0.1.
scrape_configs:
  - job_name: prometheus
    metrics_path: /prometheus/metrics
    static_configs:
      - targets: ["127.0.0.1:{{ app_ports.prometheus }}"]

  - job_name: node-exporter
    static_configs:
      - targets: ["127.0.0.1:{{ app_ports.node_exporter }}"]

  - job_name: angie
    static_configs:
      - targets: ["127.0.0.1:{{ app_ports.angie_status }}"]

  - job_name: keycloak
    static_configs:
      - targets:
{% for port in app_ports.keycloak_management %}
          - "127.0.0.1:{{ port }}"
{% endfor %}

  - job_name: mysqld-exporter
    static_configs:
      - targets: ["127.0.0.1:{{ app_ports.mysqld_exporter }}"]

  - job_name: podman
    static_configs:
      - targets: ["127.0.0.1:{{ app_ports.podman_exporter }}"]
