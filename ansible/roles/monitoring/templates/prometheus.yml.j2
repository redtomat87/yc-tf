# {{ ansible_managed }}
# Prometheus в сети хоста: экспортеры (node, Angie, Keycloak, MySQL, Podman) слушают
# только 127.0.0.1, из bridge-сети их не видно. Сам Prometheus тоже слушает 127.0.0.1,
# снаружи — через Angie (/prometheus под basic auth).
apiVersion: v1
kind: ConfigMap
metadata:
  name: prometheus-config
data:
  prometheus.yml: {{ lookup('ansible.builtin.template', 'prometheus-config.yml.j2') | to_json }}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: prometheus-data
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 5Gi
---
apiVersion: v1
kind: Pod
metadata:
  name: prometheus
  labels:
    app: monitoring
    component: prometheus
spec:
  hostNetwork: true
  containers:
    - name: prometheus
      image: {{ monitoring_prometheus_image }}
      args:
        - --config.file=/etc/prometheus/prometheus.yml
        - --storage.tsdb.path=/prometheus
        - --storage.tsdb.retention.time={{ monitoring_prometheus_retention }}
        - --web.listen-address=127.0.0.1:{{ app_ports.prometheus }}
        - --web.external-url={{ monitoring_grafana_url }}/prometheus
        - --web.route-prefix=/prometheus
      # В образе только wget, а httpGet-пробу Podman выполняет через curl.
      livenessProbe:
        exec:
          command: [wget, -q, -O, /dev/null, "http://127.0.0.1:{{ app_ports.prometheus }}/prometheus/-/ready"]
        initialDelaySeconds: 10
        periodSeconds: 15
      resources:
        limits:
          memory: {{ monitoring_prometheus_memory_limit }}
      volumeMounts:
        - name: config
          mountPath: /etc/prometheus
          readOnly: true
        - name: data
          mountPath: /prometheus
  volumes:
    - name: config
      configMap:
        name: prometheus-config
    - name: data
      persistentVolumeClaim:
        claimName: prometheus-data
