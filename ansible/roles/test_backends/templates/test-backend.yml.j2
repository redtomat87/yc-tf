# {{ ansible_managed }}
apiVersion: v1
kind: Pod
metadata:
  name: test-backend-{{ test_backend_index }}
  labels:
    app: test-backend
spec:
  containers:
    - name: webdebugger
      image: {{ test_backends_image }}
      env:
        - name: APP_PORT
          value: "8080"
        - name: APP_BGCOLOR
          value: {{ test_backend_color }}
        - name: APP_DELAY
          value: "{{ test_backends_delay }}"
      ports:
        - containerPort: 8080
      resources:
        limits:
          memory: 64Mi
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          drop: [ALL]
