        <mxCell id="le" value="Let's Encrypt&lt;br&gt;ACME http-01" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="800" width="170" height="90" as="geometry" />
