        <mxCell id="m_legend" value="&lt;b&gt;Связи&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#d6001c&quot;&gt;━━ &lt;/font&gt;внешний трафик&lt;br&gt;&lt;font color=&quot;#ff8000&quot;&gt;━━ &lt;/font&gt;Angie → бэкенд&lt;br&gt;&lt;font color=&quot;#0050ef&quot;&gt;━━ &lt;/font&gt;базы данных&lt;br&gt;&lt;font color=&quot;#7f00ff&quot;&gt;━━ &lt;/font&gt;кластер Keycloak (JGroups)&lt;br&gt;&lt;font color=&quot;#008a00&quot;&gt;┅┅ &lt;/font&gt;сбор метрик&lt;br&gt;&lt;font color=&quot;#e3008c&quot;&gt;┅┅ &lt;/font&gt;OAuth Grafana → Keycloak&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;┅┅ &lt;/font&gt;инфраструктура" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="10" y="880" width="220" height="190" as="geometry" />
        </mxCell>
        <mxCell id="m_note" value="&lt;b&gt;Адреса&lt;/b&gt; (group_vars/all/topology.yml)&lt;br&gt;сервис на той же ВМ — 127.0.0.1, на другой — private_ip из inventory.&lt;br&gt;&lt;br&gt;Порт на частном IP публикуется, только если потребитель на другой ВМ; JGroups — всегда.&lt;br&gt;&lt;br&gt;Пример из tfvars:&lt;br&gt;angie: web, test_backends&lt;br&gt;apps-a: wordpress, keycloak_db, keycloak&lt;br&gt;apps-b: keycloak, prometheus, grafana" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
