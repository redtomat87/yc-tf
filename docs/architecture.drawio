<mxfile host="Electron" agent="claude">
  <diagram name="Одна ВМ" id="yc-vm-architecture">
    <mxGraphModel dx="2400" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== Внешнее ===== -->
        <mxCell id="admin" value="&lt;b&gt;Машина администратора&lt;/b&gt;&lt;br&gt;terraform, ansible, yc&lt;br&gt;ansible/files/acme-backup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
