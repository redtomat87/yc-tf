        </mxCell>

        <!-- ===== ВМ ===== -->
        <mxCell id="vm" value="ВМ Ubuntu 26.04 — cloud-init (ssh_user), AppArmor enforce. Все группы на одной ВМ: web, wordpress, keycloak, keycloak_db, prometheus, grafana, test_backends — связи через 127.0.0.1 (разнос по ВМ — лист «Три ВМ»)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fillColor=#fafafa;strokeColor=#333333;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="170" width="1790" height="1380" as="geometry" />
        </mxCell>

        <!-- Колонка 1: Angie и хост -->
        <mxCell id="angie" value="&lt;b&gt;Angie&lt;/b&gt; (хост, профиль AppArmor angie)&lt;br&gt;:80 → 301 + ACME http-01&lt;br&gt;:443 tcp/udp, неизвестный SNI отклоняется&lt;br&gt;SAN-сертификат site_rsa + site_ecdsa,&lt;br&gt;общий account.key&lt;br&gt;127.0.0.1:8079 /status/, /metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1">
