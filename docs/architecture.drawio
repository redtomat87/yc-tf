        <mxCell id="podman" value="&lt;b&gt;Podman 6&lt;/b&gt; (OBS alvistack), rootful&lt;br&gt;Kubernetes YAML + Quadlet .kube&lt;br&gt;UserNS=auto, слот UID на pod&lt;br&gt;AppArmor containers-default&lt;br&gt;порты только 127.0.0.1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
