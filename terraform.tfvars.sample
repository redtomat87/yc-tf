# Этот файл содержит переменные для Terraform. Скопируйте в terraform.tfvars и поправьте.

# Доступ к ВМ

# Пользователь, которого создаст cloud-init (user-data). Это же имя попадёт в ansible inventory.
# Нельзя root и ubuntu. По умолчанию "user".
ssh_user = "user"

# Путь до вашего публичного SSH-ключа. cloud-init положит его в authorized_keys пользователя ssh_user.
ssh_public_key_file = "~/.ssh/id_rsa.pub"

# Откуда разрешён SSH (security group). Лучше сузить до своего адреса, например ["203.0.113.10/32"].
ssh_allowed_cidrs = ["0.0.0.0/0"]

# Порты, открытые в интернет. Остальное (контейнеры, экспортеры) слушает только 127.0.0.1.
public_tcp_ports = [80, 443]
public_udp_ports = [443] # HTTP/3

# Общие метки

# Общие метки, которые будут применены ко всем ресурсам (виртуальным машинам, дискам и т.д.).
# Используются для организации и фильтрации ресурсов в Yandex Cloud.
common_labels = {
  "project"    = "pet",
  "user_email" = "mymail_at_mail_ru",
  "managed_by" = "terraform"
}

# Конфигурация сетей и подсетей

# Сети и их подсети. Каждая сеть может иметь несколько подсетей; на каждую сеть создаётся своя security group.
networks = {
  angie-network = {
    subnets = {
      angie-subnet = {
        cidr_block = "192.168.10.0/24"
      }
      angie-subnet-1 = {
        cidr_block = "192.168.20.0/24"
      }
    }
  }
}

# Конфигурация виртуальных машин (Yandex Compute Cloud)

# Ключ — имя ВМ (уникальное, 3-63 символа: a-z, 0-9, дефис). Обязательны только network_name и subnet_name,
# остальное имеет значения по умолчанию (указаны в комментариях).
## Сайзинг: https://yandex.cloud/ru/docs/compute/concepts/performance-levels
vms = {
  angie = {
    # Метки ВМ. Дополняют common_labels. По label environment в inventory создаётся одноимённая группа.
    labels = {
      "environment" = "production"
      "role"        = "webserver"
    }
    # Группы ansible inventory для этой ВМ (a-z, 0-9, _). Плейбуки выбирают хосты по группам:
    # web — Angie и статика, apps — контейнерные приложения. По умолчанию [].
    ansible_groups = ["web", "apps"]

    # Количество ядер CPU (2).
    cores = 2
    # Объем оперативной памяти в GB (4). Весь стек приложений на одной ВМ требует ~8 GB.
    memory = 8
    # Гарантированная доля vCPU, допустимые значения зависят от платформы (100).
    core_fraction = 50
    # Платформа (standard-v3).
    platform_id = "standard-v3"
    # [Прерываемая](https://yandex.cloud/ru/docs/compute/concepts/preemptible-vm) ВМ (false).
    preemptible = true

    # Семейство [образа](https://yandex.cloud/ru/docs/compute/operations/images-with-pre-installed-software/get-list) (ubuntu-2604-lts).
    # Берётся последний образ семейства; обновление образа в семействе не пересоздаёт уже созданный диск.
    image_family = "ubuntu-2604-lts"
    ## [Тип](https://yandex.cloud/ru/docs/compute/concepts/disk) загрузочного диска (network-ssd).
    boot_disk_type = "network-ssd"
    # Размер загрузочного диска в GB (20).
    boot_disk_size = 30
    # Диск удаляется только вместе с ВМ из vms (terraform destroy или удаление записи);
    # при пересоздании ВМ (например, при переключении static_ip) он сохраняется.

    # Публичный адрес (true).
    nat = true
    # Зарезервировать статический публичный адрес (false). Без него адрес меняется при перезапуске
    # ВМ, и DNS-записи устаревают. Требует nat = true. При переключении в false адрес удаляется.
    static_ip = false

    # DNS-записи в зоне dns_zone: "angie" даёт angie.redtomat.ru. Требуют nat = true. По умолчанию [].
    dns_records = ["angie", "angie-backend", "daily", "static", "auth", "grafana"]

    # Сеть и подсеть из networks.
    network_name = "angie-network"
    subnet_name  = "angie-subnet"
  }

  # Минимальная ВМ: всё по умолчанию.
  # example = {
  #   network_name = "angie-network"
  #   subnet_name  = "angie-subnet-1"
  # }
}

# Конфигурация DNS
# Для корректной конфигурации DNS требуется делегирование вашего домена на Cloud DNS серверы yandex см. [документацию](https://yandex.cloud/ru/docs/troubleshooting/dns/how-to/delegate-public-zone)

# Зона доступности в Yandex Cloud.
zone_of_availability = "ru-central1-a"

# Имя DNS зоны. Должно заканчиваться точкой.
dns_zone = "redtomat.ru."
